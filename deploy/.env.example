# Pico — full production stack env template
#   cp .env.example .env   then fill in the three required values.
#
# These are SERVER-side secrets/config only. No client secrets exist:
# media never touches the server (P2P, DTLS-SRTP end-to-end).

# ── Required ────────────────────────────────────────────────────────────────
# The domain Caddy serves with automatic HTTPS, and clients dial for TURN.
# Example: call.example.com
PICO_DOMAIN=

# Shared secret for TIME-limited TURN credentials (HMAC-SHA256, rest-enabled).
# Generate once with:  openssl rand -hex 32
TURN_SECRET=

# The public IPv4 of the VPS running coturn — advertised as the relay address.
TURN_PUBLIC_IP=

# ── Optional (sane defaults shown) ──────────────────────────────────────────
# Token for the TURN-observability half of /api/health (allocations vs
# quotas). Public /api/health stays {ok, version} only. Generate with
# `openssl rand -hex 24`; pass as ?token=… or the x-health-token header.
# scripts/check-live.sh FAILS a deployment that leaves this unset.
# HEALTH_TOKEN=
# Deployment version — the socket version handshake, the x-pico-version
# header, the service worker's per-version caches and /api/health all key
# off it. Set it per deploy (e.g. the git short SHA): PICO_VERSION=$(git
# rev-parse --short HEAD). Empty → falls back to the git short hash at
# build time, then package.json (warned loudly; check-live.sh flags it).
# PICO_VERSION=
# TCP port coturn serves TURN-over-TLS (turns:) on. Single-IP default 8443
# (443 belongs to Caddy). ⚠ 8443 is a convenience default, NOT a guarantee:
# corporate/hotel firewalls that allow only outbound 80+443 block it exactly
# like 3478. If those networks matter, run a true-443 setup (dedicated IP or
# SNI multiplex via Caddy layer4) — see the "TURN over TLS" section in
# DEPLOY.md. /api/ice derives the turns: entry from TURN_TLS_HOST + this port.
TURN_TLS_PORT=8443
# Hostname of the turns: listener. Default turn.<PICO_DOMAIN>: Caddy obtains a
# dedicated LE certificate for it (site block in Caddyfile.production), coturn
# serves that cert, /api/ice advertises turns:<TURN_TLS_HOST>:<TURN_TLS_PORT>.
# ⚠ Requires a DNS A/AAAA record for the name. Set it equal to PICO_DOMAIN
# only if you also DELETE the {$TURN_TLS_HOST} site block in the Caddyfile
# (duplicate site addresses are rejected by Caddy).
# TURN_TLS_HOST=turn.example.com
# Renewal-watcher cadence in seconds (coturn reloads certs on SIGUSR2).
# TURN_CERT_CHECK_INTERVAL=300
# Set to 0 to stop /api/ice from advertising the turns: entry.
# TURN_TLS_443=1
# Explicit PEM cert/key for turns: (optional — by default coturn reuses the
# Let's Encrypt certificate from Caddy's storage; a REAL cert is required,
# browsers validate TURN TLS certificates).
# TURN_CERT_FILE=/path/turn.crt
# TURN_KEY_FILE=/path/turn.key

# Override only if you split the signaling service onto another origin.
# PICO_SIGNALING_URL=/
# PICO_ROOM_INFO_URL=/info
