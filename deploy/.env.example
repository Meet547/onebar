# Pico — full production stack env template
#   cp .env.example .env   then fill in the three required values.
#
# These are SERVER-side secrets/config only. No client secrets exist:
# media never touches the server (P2P, DTLS-SRTP end-to-end).

# ── Required ────────────────────────────────────────────────────────────────
# The domain Caddy serves with automatic HTTPS, and clients dial for TURN.
# Example: call.example.com
PICO_DOMAIN=

# Shared secret for TIME-limited TURN credentials (HMAC-SHA256, rest-enabled).
# Generate once with:  openssl rand -hex 32
TURN_SECRET=

# The public IPv4 of the VPS running coturn — advertised as the relay address.
TURN_PUBLIC_IP=

# ── Optional (sane defaults shown) ──────────────────────────────────────────
# TCP port coturn serves TURN-over-TLS (turns:) on. Single-IP default 8443
# (443 belongs to Caddy). 8443 still gets through many restrictive networks;
# for true turns:<domain>:443 give coturn a dedicated second IP, or multiplex
# by SNI with Caddy's layer4 module — see the "TURN over TLS" section in
# DEPLOY.md. /api/ice derives turns:<domain>:<this port> automatically.
TURN_TLS_PORT=8443
# Set to 0 to stop /api/ice from advertising the turns: entry.
# TURN_TLS_443=1
# Explicit PEM cert/key for turns: (optional — by default coturn reuses the
# Let's Encrypt certificate from Caddy's storage; a REAL cert is required,
# browsers validate TURN TLS certificates).
# TURN_CERT_FILE=/path/turn.crt
# TURN_KEY_FILE=/path/turn.key

# Override only if you split the signaling service onto another origin.
# PICO_SIGNALING_URL=/
# PICO_ROOM_INFO_URL=/info
