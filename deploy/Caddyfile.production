# Pico production gateway — automatic HTTPS via Let's Encrypt.
#
#   app        -> internal :3000   (Next.js)
#   signaling  -> internal :3003   (socket.io, path /socket.io)
#              -> internal :3004   (room-info probe + /health)
#
# WebSocket upgrade on /socket.io is handled automatically by Caddy.
#
# NOTE on TCP 443: Caddy owns 443 here. coturn's turns: TLS listener defaults
# to 8443 on a single-IP host (still passes most restrictive networks). For
# true turns:…:443, either give coturn a dedicated public IP, or multiplex by
# SNI with Caddy's layer4 module — see the "TURN over TLS" section in DEPLOY.md.

{$PICO_DOMAIN} {
	encode zstd gzip

	# Signaling relay (websocket + polling fallback)
	handle /socket.io/* {
		reverse_proxy signaling:3003
	}
	handle /socket.io {
		reverse_proxy signaling:3003
	}

	# Room-info probe (passcode / lock / occupancy) + service health
	handle /info* {
		reverse_proxy signaling:3004
	}
	handle /healthz {
		reverse_proxy signaling:3004
	}

	# Everything else — the Pico app
	handle {
		reverse_proxy app:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}
}
