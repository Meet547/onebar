# Pico production gateway — automatic HTTPS via Let's Encrypt.
#
#   app        -> internal :3000   (Next.js)
#   signaling  -> internal :3003   (socket.io, path /socket.io)
#              -> internal :3004   (room-info probe + /health)
#
# WebSocket upgrade on /socket.io is handled automatically by Caddy.
#
# NOTE on TCP 443: Caddy owns 443 here. coturn's turns: TLS listener defaults
# to 8443 on a single-IP host — but 80/443-only firewalls block 8443 exactly
# like 3478. For true turns:…:443, either give coturn a dedicated public IP,
# or multiplex by SNI with a Caddy build carrying the layer4 module
# (github.com/mholt/caddy-l4) — the working config shape is in DEPLOY.md
# (validated with Caddy 2.11.9 + layer4).

{$PICO_DOMAIN} {
	# Brotli is the smallest wire format browsers accept (zstd where offered,
	# gzip for everything else). The app handler below strips Accept-Encoding
	# toward the origin (`header_up … identity`) because `next start` would
	# otherwise gzip responses itself and Caddy's encode skips already-encoded
	# bodies — i.e. without that line browsers would never actually get br.
	encode zstd br gzip

	# Signaling relay (websocket + polling fallback)
	handle /socket.io/* {
		reverse_proxy signaling:3003
	}
	handle /socket.io {
		reverse_proxy signaling:3003
	}

	# Room-info probe (passcode / lock / occupancy) + service health
	handle /info* {
		reverse_proxy signaling:3004
	}
	handle /healthz {
		reverse_proxy signaling:3004
	}

	# Everything else — the Pico app
	handle {
		reverse_proxy app:3000 {
			# See `encode` above: keep the origin's responses uncompressed so
			# Caddy itself picks br/zstd/gzip per client. Direct (non-Caddy)
			# access to the app keeps Next's own gzip.
			header_up Accept-Encoding identity
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Camera/mic/display-capture stay same-origin; everything else denied.
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=(), usb=()"
		# CSP: Next.js injects inline bootstrap scripts and styles → 'unsafe-inline'
		# for script/style (pragmatic; removing it needs nonce plumbing through
		# every page). WebRTC's ICE needs stun:/turn:/turns: in connect-src.
		# blob: covers MediaStream <video> srcObject and screen-share previews.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' stun: turn: turns:; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
}

# TURN SNI hostname (TURN_TLS_HOST, default turn.<PICO_DOMAIN>): this block
# exists ONLY so Caddy obtains and renews the Let's Encrypt certificate for
# the TURN TLS host — coturn serves that cert from the shared caddy_data
# volume. The optional layer4 multiplex (stock caddy:2 has no layer4 module;
# operators build it per DEPLOY.md) matches the same SNI and proxies to
# host-gateway:8443 — coturn is host-networked, and a bridge-local
# 127.0.0.1 would be Caddy itself. Requires
# a DNS record for the name. If you set TURN_TLS_HOST equal to PICO_DOMAIN,
# DELETE this block — Caddy rejects duplicate site addresses.
{$TURN_TLS_HOST} {
	respond 421
}
