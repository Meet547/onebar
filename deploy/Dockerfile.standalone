# Pico — plain Next.js app container (the embedded relay runs inside it).
# Reference for self-hosters; the recommended path is simply:
#   bun install && bun run build && bun run start
# The full multi-container stack (separate relay + TURN + Caddy) is in
# docker-compose.yml next to this file.
#
# Build:  docker build -f deploy/Dockerfile.standalone -t pico-app .
# Run:    docker run -p 3000:3000 pico-app

FROM oven/bun:1 AS deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

FROM oven/bun:1 AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Public runtime config is baked into the client bundle at build time.
ARG NEXT_PUBLIC_SIGNALING_URL=/
ARG NEXT_PUBLIC_SOCKET_PATH=/socket.io
ARG NEXT_PUBLIC_ROOM_INFO_URL=/info
ARG NEXT_PUBLIC_SITE_URL=http://localhost:3000
ENV NEXT_PUBLIC_SIGNALING_URL=$NEXT_PUBLIC_SIGNALING_URL \
    NEXT_PUBLIC_SOCKET_PATH=$NEXT_PUBLIC_SOCKET_PATH \
    NEXT_PUBLIC_ROOM_INFO_URL=$NEXT_PUBLIC_ROOM_INFO_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_TELEMETRY_DISABLED=1

RUN bun run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1
COPY --from=builder /app ./
EXPOSE 3000
CMD ["npx", "next", "start"]
